{
    "name": "php-io-extensions/ftdi",
    "type": "php-ext",
    "description": "PHP bindings of libftdi1: FTDI USB devices, MPSSE, async transfers and EEPROM",
    "license": "MIT",
    "version": "0.10.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "build": [
                        "libftdi1-dev",
                        "libusb-1.0-0-dev"
                    ]
                },
                "brew": {
                    "build": [
                        "libftdi",
                        "libusb"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "ftdi",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families-exclude": [
            "windows"
        ],
        "configure-options": [
            {
                "name": "enable-ftdi",
                "description": "Enable the ftdi extension",
                "needs-value": false
            }
        ]
    }
}
